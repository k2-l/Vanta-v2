# =====================================================================
# 前端环境变量
# =====================================================================
#
# 本地开发（两服务各自监听）：
#   将下面两行取消注释，填入实际地址
#
# VITE_API_BASE=http://127.0.0.1:8765
# VITE_NEXUS_BASE=http://127.0.0.1:8766
#
# Docker / nginx 同域代理（推荐生产部署）：
#   保持空值即可，前端请求通过 nginx 转发
#   nginx 配置示例：
#     location /suite/ { proxy_pass http://hermes:8765; }
#     location /sessions/ { proxy_pass http://hermes:8765; }
#     location /api/  { proxy_pass http://nexus-svc:8766; }
#
VITE_API_BASE=
VITE_NEXUS_BASE=
