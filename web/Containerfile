# web (React+Vite) — 多阶段：node 构建 dist → nginx alpine-slim 托管 + 反代
# 前端 VITE_API_BASE 留空 → 走同域 window.location.origin，由 nginx 反代到后端

# ── 构建阶段 ─────────────────────────────────────────────────────────
FROM docker.io/library/node:22-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── 运行阶段：nginx alpine-slim（13.6MB）────────────────────────────
FROM docker.io/library/nginx:alpine3.22-slim
COPY --from=build /web/dist /usr/share/nginx/html
COPY deploy/web-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
